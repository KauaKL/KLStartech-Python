# Imagens temporárias
*.tmp
*.temp
temp/
tmp/

# Avatares gerados
app/ui/avatars/generated/
app/ui/avatars/temp/

# Logs de aplicação
logs/
*.log
logfile.log

# Arquivos de debug
debug/
*.debug

