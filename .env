# =====================================================
# 🔐 .env — Configurações Seguras DashFin Supremo
# by KLStarTech (Kauã Lima) + DeepSeek AI
# ATENÇÃO: NUNCA compartilhe este arquivo com chaves reais!
# =====================================================

# =====================================================
# 📧 CONFIGURAÇÕES DE E-MAIL (SMTP)
# =====================================================

# Servidor SMTP (Gmail)
ALERT_EMAIL_HOST=smtp.gmail.com
ALERT_EMAIL_PORT=587

# Credenciais de e-mail - USE SENHA DE APP DO GMAIL!
ALERT_EMAIL_USER=seu_email@gmail.com
ALERT_EMAIL_PASS=sua_senha_de_app_aqui

# E-mail destino para alertas
ALERT_EMAIL_TO=seu_email@gmail.com

# =====================================================
# 🎙️ CONFIGURAÇÕES DE VOZ E TTS
# =====================================================

# ElevenLabs TTS (opcional - para vozes premium)
ELEVENLABS_API_KEY=sua_elevenlabs_api_key_aqui
ELEVEN_VOICE_ID=alloy

# Configuração do modelo de voz padrão
TTS_PROVIDER=browser  # browser / elevenlabs / local
DEFAULT_VOICE_PROFILE=moderna

# =====================================================
# 🧠 CONFIGURAÇÕES DE IA E LLM
# =====================================================

# Backend principal de IA
LLM_BACKEND=openai  # openai / gemini / deepseek / local

# OpenAI Configuration
OPENAI_API_KEY=sua_openai_api_key_aqui
OPENAI_MODEL=gpt-4o-mini  # gpt-4o, gpt-4, gpt-3.5-turbo

# Google Gemini Configuration  
GEMINI_API_KEY=sua_gemini_api_key_aqui
GEMINI_MODEL=gemini-1.5-flash

# DeepSeek Configuration
DEEPSEEK_API_KEY=sua_deepseek_api_key_aqui
DEEPSEEK_MODEL=deepseek-chat

# Configurações locais (para modelos auto-hospedados)
LOCAL_LLM_URL=http://localhost:11434
LOCAL_LLM_MODEL=llama2

# =====================================================
# 🎭 CONFIGURAÇÕES DA ESTELAR (AVATAR)
# =====================================================

# Modelo Live2D
ESTELAR_LIVE2D_MODEL=https://unpkg.com/live2d-widget-model-haru@1.0.5/assets/haru.model.json

# Avatar e tema
ESTELAR_AVATAR_STYLE=holografico
ESTELAR_THEME=dark_tech

# =====================================================
# ⚙️ CONFIGURAÇÕES DO SISTEMA
# =====================================================

# Modo de operação
APP_ENV=development  # development / production
DEBUG_MODE=True
LOG_LEVEL=INFO

# Configurações de cache
CACHE_TIMEOUT=300  # 5 minutos
MAX_CACHE_SIZE=1000

# Configurações de automação
AUTOMATION_INTERVAL=3600  # 1 hora
ALERT_COOLDOWN=1800  # 30 minutos

# =====================================================
# 🔧 CONFIGURAÇÕES AVANÇADAS
# =====================================================

# Timeouts de API
REQUEST_TIMEOUT=30
API_RETRY_ATTEMPTS=3

# Configurações de segurança
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
CSRF_TRUSTED_ORIGINS=http://localhost:8501

# Configurações de monitoramento
ENABLE_METRICS=True
HEALTH_CHECK_INTERVAL=60